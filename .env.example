# Copy to .env for local manual testing (not read automatically — the server
# reads plain environment variables; export these in your shell or set them
# in your MCP client's `env` block instead).

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=pl

RAPIDAPI_JSEARCH_KEY=
JSEARCH_COUNTRY=pl

LINT_RULES_PATH=
REGISTRY_CONFIG_PATH=

# Override only if auto-detection picks the wrong binary.
CHROME_PATH=

# search_jobs result cache (protects JSearch's 200 req/month free quota).
SEARCH_CACHE_DIR=
SEARCH_CACHE_TTL_SECONDS=
